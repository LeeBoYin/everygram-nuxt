rules_version = '2';
service cloud.firestore {
	function isAuthenticated() {
		return request.auth != null;
	}

	function adminRole() {
		return request.auth != null ? request.auth.token.adminRole : null;
	}

	function isAdmin() {
		return adminRole() in ['owner', 'admin'];
	}

	function isOwner() {
		return isAuthenticated() && resource.data.role[request.auth.uid] == 'owner';
	}

	// `role` of a new doc must contain the creator only, as the owner
	function isCreatingOwnDoc() {
		return request.resource.data.role.keys().hasOnly([request.auth.uid])
			&& request.resource.data.role[request.auth.uid] == 'owner';
	}

	// clients can never change `role` of an existing doc
	function isRoleUnchanged() {
		return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
	}

	function userMetaCountFields() {
		return ['gearCount', 'archivedGearCount', 'tripCount', 'tripShareCount'];
	}

	match /databases/{database}/documents {
		// gear
		match /gear/{gearID} {
			allow create: if isAuthenticated() && isCreatingOwnDoc();
			allow read, delete: if isOwner();
			allow update: if isOwner() && isRoleUnchanged();
		}
		
		// user gears
		match /userGears/{userID} {
			allow create: if isAuthenticated() && userID == request.auth.uid;
			allow read, update, delete: if userID == request.auth.uid;
		}
		
		// trip
		match /trip/{tripID} {
			allow create: if isAuthenticated() && isCreatingOwnDoc();
			allow read, delete: if isOwner();
			allow update: if isOwner() && isRoleUnchanged();
		}
		
		// trip share, only admin is allowed to write
		match /tripShare/{tripID} {
			allow read: if true;
			allow create, update, delete: if false;
		}
		
		// trip meta, only admin is allowed to write
		match /tripMeta/{tripID} {
			allow read: if true;
			allow create, update, delete: if false;
		}
		
		// user meta, the counts are only written by the admin SDK
		match /userMeta/{userID} {
			allow read: if isAuthenticated() && userID == request.auth.uid;
			allow create: if isAuthenticated() && userID == request.auth.uid
				&& !request.resource.data.keys().hasAny(userMetaCountFields());
			allow update: if isAuthenticated() && userID == request.auth.uid
				&& !request.resource.data.diff(resource.data).affectedKeys().hasAny(userMetaCountFields());
			// no delete: deleting and creating again would reset the counts
		}

		// admin dashboard, only the admin SDK is allowed to write
		match /adminStats/{doc} {
			allow read: if isAdmin();
			allow write: if false;
		}

		match /adminSnapshots/{doc} {
			allow read: if isAdmin();
			allow write: if false;
		}

		match /adminUsers/{userID} {
			allow read: if isAdmin();
			allow write: if false;
		}
	}
}
