{
    "compilerOptions": {
        "module": "node20",
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "outDir": "lib",
        "sourceMap": true,
        "strict": true,
        "target": "es2022",
        "esModuleInterop": true,
        "resolveJsonModule": true
    },
    "compileOnSave": true,
    "include": ["src"]
}
