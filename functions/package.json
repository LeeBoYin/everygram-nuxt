{
    "name": "functions",
    "scripts": {
        "sync-shared": "node scripts/sync-shared-constants.mjs",
        "build": "node scripts/sync-shared-constants.mjs && tsc",
        "build:watch": "tsc --watch",
        "serve": "npm run build && firebase emulators:start --only functions",
        "shell": "npm run build && firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log",
        "admin:set-owner": "node scripts/set-admin-owner.mjs",
        "check:roles": "node scripts/check-invalid-roles.mjs"
    },
    "engines": {
        "node": "24"
    },
    "main": "lib/index.js",
    "dependencies": {
        "@anthropic-ai/sdk": "^1.13.0",
        "@sparticuz/chromium": "153.0.0",
        "cheerio": "^1.2.0",
        "firebase-admin": "^14.5.1",
        "firebase-functions": "^7.4.0",
        "lodash": "^4.18.1",
        "papaparse": "^5.7.1",
        "puppeteer-core": "25.11.0",
        "sharp": "^0.35.5"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "@types/papaparse": "^5.5.2",
        "firebase-functions-test": "^3.5.0",
        "typescript": "~5.9.3"
    },
    "private": true,
    "overrides": {
        "firebase-functions-test": {
            "firebase-admin": "$firebase-admin"
        }
    }
}
